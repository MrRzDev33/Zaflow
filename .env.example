# ==============================================================================
# ZaFlow - Contoh konfigurasi environment
# Salin menjadi .env.local (atau .env) lalu isi nilainya.
# .env.local lebih diprioritaskan daripada .env.
#
# Untuk Vercel: JANGAN commit file ini. Masukkan nilai yang sama lewat
# Project Settings -> Environment Variables, lalu Redeploy.
# ==============================================================================

# --- SERVER ---
PORT=3000
NODE_ENV=development
# APP_URL wajib diisi saat produksi agar callback Midtrans kembali ke domain yang benar.
# Di Vercel isi dengan https://domain-anda.com
APP_URL="http://localhost:3000"

# --- SUPABASE ---
# Dashboard Supabase -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
# HANYA untuk server. Jangan pernah memakai prefix VITE_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# --- AI GEMINI (backend) ---
GEMINI_API_KEY=""
# Daftar model dipisah koma; server mencoba berurutan.
GEMINI_MODELS="gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-flash-lite-latest"
# Di Vercel, default otomatis 50000 ms dan dibatasi maksimal 55000 ms
# agar tidak kena batas 60 detik. Function Vercel dibatasi request body 4.5 MB;
# upload AI dibatasi 3 MB.
GEMINI_TIMEOUT_MS=120000

# --- MIDTRANS ---
# Ambil dari Dashboard Midtrans -> Settings -> Access Keys.
# Sandbox: https://dashboard.sandbox.midtrans.com
# Production: https://dashboard.midtrans.com
# Sandbox key berprefix SB-Mid-server- / SB-Mid-client-.
# Production key berprefix Mid-server- / Mid-client-.
# Jangan mencampur key sandbox dengan MIDTRANS_IS_PRODUCTION=true.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
# false = sandbox, true = production. Harus cocok dengan prefix key.
MIDTRANS_IS_PRODUCTION=false

# Pengembangan lokal saja. JANGAN aktifkan di production.
# Jika true dan Midtrans belum dikonfigurasi, pembelian paket langsung mengaktifkan lisensi.
ALLOW_SANDBOX_CHECKOUT=false

# --- WEBHOOK GENERIK (opsional) ---
# Hanya dipakai oleh /api/webhook/payment untuk provider selain Midtrans.
PAYMENT_WEBHOOK_SECRET=""
